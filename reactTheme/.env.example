# Backend origin, no /api suffix. Copy this file to `.env`.
#
# Only the protocol and port are used: apiClient.ts swaps in the hostname the
# SPA is currently served from, so acme.localhost:5173 talks to
# acme.localhost:8000 and the backend can identify the tenant. Changing the
# hostname here has no effect — change the port/protocol only.
VITE_BACKEND_URL=http://localhost:8000

# Comma-separated hostnames that are the CENTRAL app (not a tenant). Must mirror
# central_domains in the backend's config/tenancy.php. Anything else is treated
# as a tenant subdomain. Set your real central domain(s) in production.
VITE_CENTRAL_HOSTS=localhost,127.0.0.1
