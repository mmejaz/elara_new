APP_NAME=Elara
APP_ENV=local
# Left blank on purpose — never commit a real key. After `cp .env.example .env`
# run `php artisan key:generate` so each environment gets its own APP_KEY.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=elara
DB_USERNAME=elara_user
DB_PASSWORD=secret

# First central admin created by DatabaseSeeder (php artisan db:seed). Override
# these in production so the initial account isn't the known dev credentials.
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=test@test.com
ADMIN_PASSWORD=password123

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Left null on purpose: a host-only cookie means acme.localhost and
# beta.localhost each get their own session, so tenants can't share a login.
# Do NOT set this to ".localhost" — that would share one cookie across tenants.
SESSION_DOMAIN=null
# Cookie hardening. http_only + same_site=lax are already the config defaults.
# SESSION_SECURE_COOKIE must be false on local http (else the browser drops the
# cookie); set it to TRUE in production so the session cookie is HTTPS-only.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

# The wildcard entry makes tenant subdomains stateful for Sanctum. Sanctum
# matches these with Str::is(), so "*" is a real wildcard here.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,*.localhost:5173
FRONTEND_URL=http://localhost:5173
# CORS also accepts *.localhost:5173 via FRONTEND_ORIGIN_PATTERN, whose default
# lives in config/cors.php. Override it there rather than here — dotenv cannot
# parse the backslash escapes a regex needs.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
